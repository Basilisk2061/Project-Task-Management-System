# Relative paths are resolved from the directory where FastAPI is started.
DATABASE_URL=sqlite:///./taskflow.db

# Replace this with a long random value in your local .env or shell environment.
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=8

# Gemini embeddings are used only by the backend RAG index builder and search.
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# NVIDIA Nemotron is used only by the backend grounded-answer generator.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
